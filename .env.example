# 复制为 .env 后填写：cp .env.example .env
# docker-compose 与本地 mvn spring-boot:run 都会读取这些环境变量

# ===== 必填 =====
# 阿里云百炼 DashScope API Key。Agent 的对话能力与默认 Embedding 都依赖它。
# 获取地址：https://bailian.console.aliyun.com/
# 不填也能启动服务（查书/借书/还书可用），但对话与语义推荐不可用。
DASHSCOPE_API_KEY=sk-your-dashscope-api-key

# ===== 可选 =====
# 填入后自动切换到硅基流动 BGE 中文向量模型（BAAI/bge-large-zh-v1.5），
# 中文语义检索效果更好；留空则使用 DashScope text-embedding-v4。
SILICONFLOW_API_KEY=

# MySQL root 密码，docker-compose 使用；不填默认 root
MYSQL_PASSWORD=root

# HikariCP 最大连接数（prod profile）
DB_POOL_SIZE=10
